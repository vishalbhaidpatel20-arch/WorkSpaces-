{
  "name": "workspace-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for WorkSpace - Smart Co-Working Space Management",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "test": "node test/api-suite.mjs",
    "seed:fresh": "node src/seed.js --fresh",
    "start:test": "node -e \"process.env.OCCUPANCY_SIMULATION=(process.env.OCCUPANCY_SIMULATION||'off');process.env.RATE_LIMIT='off';import('./src/index.js')\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  }
}
