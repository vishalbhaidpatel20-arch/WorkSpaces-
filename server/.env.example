# Copy to server/.env and adjust. Never commit the real .env.

# --- core -------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# --- auth -------------------------------------------------------------------
# REPLACE BEFORE DEPLOYING. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_TTL=7d

# --- database ---------------------------------------------------------------
# Absolute or relative path to the SQLite file.
DB_PATH=./data/app.db

# --- real-time monitoring ---------------------------------------------------
# Set to "off" to disable the occupancy simulator (required for deterministic tests).
OCCUPANCY_SIMULATION=on
OCCUPANCY_INTERVAL_MS=15000

# --- notifications ----------------------------------------------------------
# With neither set, messages are persisted and logged instead of sent.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMS_API_KEY=
