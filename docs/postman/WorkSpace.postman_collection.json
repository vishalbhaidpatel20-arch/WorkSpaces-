            "url": {
              "raw": "{{baseUrl}}/admin/users?role=owner",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [{ "key": "role", "value": "owner" }]
            }
          }
        },
        {
          "name": "Settle past bookings",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/bookings/settle",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "bookings", "settle"]
            }
          }
        },
        {
          "name": "Admin route as owner (must be 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('role boundary holds', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        }
      ]
