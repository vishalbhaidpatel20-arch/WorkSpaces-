    {
      "name": "Dashboards",
      "item": [
        {
          "name": "Member dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/user", "host": ["{{baseUrl}}"], "path": ["dashboard", "user"] }
          }
        },
        {
          "name": "Owner dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/owner", "host": ["{{baseUrl}}"], "path": ["dashboard", "owner"] }
          }
        },
        {
          "name": "Owner dashboard as member (must be 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/owner", "host": ["{{baseUrl}}"], "path": ["dashboard", "owner"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('role boundary holds', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        },
        {
          "name": "Admin dashboard and KPIs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/admin", "host": ["{{baseUrl}}"], "path": ["dashboard", "admin"] }
          }
        }
      ]
    },

    {
      "name": "Admin",
      "item": [
