            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Pending verification of floor plans.\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/admin/spaces/13/suspend",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "spaces", "13", "suspend"]
            }
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
